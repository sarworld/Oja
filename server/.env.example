# Oja server — local dev environment.
# The canonical .env.example lives at the repo root; this is a convenience copy
# for running the backend on its own. Copy to `.env` and fill in.
#
# v1.1: the server starts even with NO Immich/vision config — you can finish
# setup in the browser at /setup. Any var set here is "locked" (read-only in the
# UI); leave the integration vars blank to configure entirely from the UI.

PORT=8462

# Auth. If unset, a temporary password is generated and printed on boot (dev).
APP_PASSWORD=changeme
SESSION_SECRET=please-change-this-to-a-long-random-string

# Storage. Default is a local sqlite file. Use a postgres:// URL for Postgres.
DATABASE_URL=sqlite:./data/oja.db
# DATABASE_URL=postgres://oja:oja@localhost:5432/oja

# Immich (optional here — can be set via the setup UI instead).
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_ALBUM=Food

# Vision LLM. VISION_PROVIDER selects the adapter:
#   openai    = any OpenAI-compatible /chat/completions endpoint (DEFAULT;
#               covers OpenAI, OpenRouter, MiniMax, Groq, Together, DeepInfra,
#               Ollama, LM Studio, vLLM, …)
#   anthropic = Anthropic native Messages API
#   gemini    = Google Generative Language API
VISION_PROVIDER=openai
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# Poller: minutes between album syncs (0 disables auto-poll).
POLL_INTERVAL_MINUTES=90

# Day-boundary timezone.
TZ=UTC
