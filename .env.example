# Oja configuration
#
# ALL of these are OPTIONAL at boot. Oja starts even with an empty .env:
# on first run it routes you to a web Setup wizard where you can enter the
# Immich and vision settings in the browser — no env file required.
#
# When you DO set a value here, that field is treated as the source of truth
# and is LOCKED (read-only, "set by environment") in the Setup/Settings UI.
# This is handy for headless / managed / reproducible deployments where you
# want config baked in rather than entered by hand.
#
# Copy this file to .env and fill in only what you want to pre-set.

# --- Core ---------------------------------------------------------------
# HTTP port the app listens on.
PORT=8462

# Single login password for the UI. Recommended even when configuring via
# the wizard (the wizard is behind this login).
APP_PASSWORD=

# Secret used to sign the session cookie — use a long random string,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Set to true when serving Oja over HTTPS (e.g. behind a TLS reverse proxy) so
# the login cookie gets the Secure flag. Leave false for plain-HTTP LAN access.
COOKIE_SECURE=false

# Database. Defaults to a single SQLite file in ./data. Set a postgres://
# URL to use Postgres instead.
# DATABASE_URL=postgres://user:pass@host:5432/oja

# --- Immich -------------------------------------------------------------
# Can all be left blank and entered in the Setup wizard instead.
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=
# Album (name or id) Oja watches for food photos.
IMMICH_ALBUM=Food

# --- Vision / LLM -------------------------------------------------------
# Can all be left blank and entered in the Setup wizard instead, which has
# presets for OpenAI, OpenRouter, MiniMax, Groq, Together, DeepInfra,
# Ollama, LM Studio, Anthropic, Google Gemini, and Custom.
#
# Adapter to use: openai (OpenAI-compatible, default — covers most
# providers incl. Ollama/LM Studio), anthropic (native), or gemini (native).
VISION_PROVIDER=openai
# OpenAI-compatible base URL (ignored by the native anthropic/gemini adapters).
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
# Any vision-capable model offered by your provider.
VISION_MODEL=gpt-4o-mini

# --- Behaviour ----------------------------------------------------------
# How often to auto-poll the album, in minutes. 0 disables auto-poll.
POLL_INTERVAL_MINUTES=90

# Timezone used for day boundaries (e.g. America/Toronto, Asia/Kolkata).
TZ=UTC
